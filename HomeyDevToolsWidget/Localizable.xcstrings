    "Installaties met de Insights-grafiek van je app of van al je apps. Houd ingedrukt → Wijzig widget om een app te kiezen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installationen mit dem Insights-Diagramm einer App oder aller Apps. Gedrückt halten → Widget bearbeiten, um eine App zu wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installs with the Insights chart of one app or all your apps. Press and hold → Edit Widget to choose an app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installations avec le graphique Insights d'une app ou de toutes vos apps. Maintenez appuyé → Modifier le widget pour choisir une app."
          }
        }
      }
    },
    "Je best geïnstalleerde Homey-apps met trend, groei, rating en status.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine meistinstallierten Homey-Apps mit Trend, Wachstum, Bewertung und Status."
