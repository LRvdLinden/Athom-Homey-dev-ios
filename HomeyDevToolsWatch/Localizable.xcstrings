    },
    "Open de app op je iPhone. Je gegevens komen dan vanzelf naar je Apple Watch.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die App auf deinem iPhone. Deine Daten kommen dann von selbst auf deine Apple Watch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app on your iPhone. Your data then comes to your Apple Watch by itself."
