    "Houd een lid ingedrukt om de rol te wijzigen, veeg om te verwijderen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ein Mitglied gedrückt, um die Rolle zu ändern; wische zum Entfernen."
          }
        },
        "en": {
