    "Maak een token aan in Developer Tools onder **My Account → Personal Access Tokens**. Het token blijft alleen in de iOS-sleutelhanger op dit toestel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle ein Token in Developer Tools unter **My Account → Personal Access Tokens**. Das Token bleibt nur im iOS-Schlüsselbund auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a token in Developer Tools under **My Account → Personal Access Tokens**. The token stays only in the iOS Keychain on this device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un jeton dans Developer Tools sous **My Account → Personal Access Tokens**. Le jeton reste uniquement dans le trousseau iOS de cet appareil."
          }
        }
      }
    },
