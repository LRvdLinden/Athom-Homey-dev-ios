    "Afgewezen – bekijk de opmerkingen hieronder, pas aan en dien een nieuwe build in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgelehnt – sieh dir die Kommentare unten an, passe die App an und reiche einen neuen Build ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejected – check the comments below, make changes and submit a new build."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Refusé – consultez les commentaires ci-dessous, apportez les modifications et soumettez un nouveau build."
