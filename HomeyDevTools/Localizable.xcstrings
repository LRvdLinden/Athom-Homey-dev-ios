    "Meld je af onder Account of verwijder de app, dan zijn alle opgeslagen sessies en tokens weg. Je Personal Access Tokens trek je in via Developer Tools → My Account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich unter Konto ab oder lösche die App, dann sind alle gespeicherten Sitzungen und Tokens weg. Deine Personal Access Tokens widerrufst du in Developer Tools → My Account."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out under Account or delete the app, and all saved sessions and tokens are gone. Revoke your Personal Access Tokens in Developer Tools → My Account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnectez-vous dans Compte ou supprimez l’app : toutes les sessions et jetons enregistrés disparaissent. Révoquez vos Personal Access Tokens dans Developer Tools → My Account."
          }
        }
      }
    },
