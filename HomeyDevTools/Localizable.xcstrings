    "Ingelogde accounts blijven veilig bewaard in de iOS-sleutelhanger. Tik om te wisselen, veeg om af te melden.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angemeldete Konten werden sicher im iOS-Schlüsselbund gespeichert. Tippe zum Wechseln, wische zum Abmelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed-in accounts are stored securely in the iOS Keychain. Tap to switch, swipe to sign out."
