    "De app volgt de taal van je toestel. Kies in Instellingen een andere taal alleen voor deze app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App folgt der Sprache deines Geräts. Wähle in den Einstellungen eine andere Sprache nur für diese App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app follows your device language. Choose a different language for this app only in Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app suit la langue de votre appareil. Choisissez une autre langue pour cette app uniquement dans Réglages."
          }
        }
      }
    },
    "De app wordt eigendom van de organisatie. Leden met de juiste rol kunnen hem daarna beheren.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App gehört dann der Organisation. Mitglieder mit der passenden Rolle können sie verwalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app becomes owned by the organization. Members with the right role can then manage it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app appartiendra à l'organisation. Les membres ayant le bon rôle pourront la gérer."
          }
        }
      }
    },
